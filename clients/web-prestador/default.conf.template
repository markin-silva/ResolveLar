# Template do Nginx (envsubst na inicialização do contêiner; ver Dockerfile).
#   KONG_UPSTREAM          host:porta do Kong (padrão kong:8000) — o ÚNICO destino das chamadas /v1/.
#   NGINX_LOCAL_RESOLVERS  DNS do ambiente (Docker 127.0.0.11 / kube-dns), preenchido pelo entrypoint.
# O destino é resolvido por requisição (variável no proxy_pass): o Nginx sobe mesmo se o Kong ainda não existe.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    location /v1/ {
        set $kong_upstream http://${KONG_UPSTREAM};
        proxy_pass $kong_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }
}
