# Copie para .env e ajuste. NUNCA commite o .env real.

# --- PostgreSQL (um usuário/senha por banco) ---
POSTGRES_USER=resolvelar
POSTGRES_PASSWORD_PRESTADORES_WRITE=change_me_prestadores_write
POSTGRES_PASSWORD_PRESTADORES_READ=change_me_prestadores_read
POSTGRES_PASSWORD_SOLICITACOES=change_me_solicitacoes
POSTGRES_PASSWORD_AGENDAMENTOS=change_me_agendamentos
POSTGRES_PASSWORD_PAGAMENTOS=change_me_pagamentos
POSTGRES_PASSWORD_AVALIACOES=change_me_avaliacoes

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=resolvelar
RABBITMQ_DEFAULT_PASS=change_me_rabbitmq
RABBITMQ_URL=amqp://resolvelar:change_me_rabbitmq@rabbitmq:5672/

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- URLs de banco por serviço (hosts internos do Compose) ---
DATABASE_URL_PRESTADORES_WRITE=postgresql://resolvelar:change_me_prestadores_write@db-prestadores-write:5432/prestadores_write
DATABASE_URL_PRESTADORES_READ=postgresql://resolvelar:change_me_prestadores_read@db-prestadores-read:5432/prestadores_read
DATABASE_URL_SOLICITACOES=postgresql://resolvelar:change_me_solicitacoes@db-solicitacoes:5432/solicitacoes
DATABASE_URL_AGENDAMENTOS=postgresql://resolvelar:change_me_agendamentos@db-agendamentos:5432/agendamentos
DATABASE_URL_PAGAMENTOS=postgresql://resolvelar:change_me_pagamentos@db-pagamentos:5432/pagamentos
DATABASE_URL_AVALIACOES=postgresql://resolvelar:change_me_avaliacoes@db-avaliacoes:5432/avaliacoes

# --- URLs internas entre serviços ---
MS_PRESTADORES_URL=http://ms-prestadores:8000
MS_SOLICITACOES_URL=http://ms-solicitacoes:8000
MS_AGENDAMENTOS_URL=http://ms-agendamentos:8000
MS_PAGAMENTOS_URL=http://ms-pagamentos:8000
MS_AVALIACOES_URL=http://ms-avaliacoes:8000
HTTP_TIMEOUT_SECONDS=3

MS_TRIAGEM_URL=http://ms-triagem:8000

# --- Triagem IA (ms-triagem) ---
# Use apenas um provedor. Sem chave válida a triagem funciona em modo fallback (regras + RAG local).
# LLM_PROVIDER: auto (escolhe pela chave preenchida) | gemini | openai | none
LLM_PROVIDER=auto
# Vazio = padrão do provedor (gemini-3.5-flash-lite / gpt-4o-mini)
LLM_MODEL=
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
# Timeout por tentativa e orçamento total do LLM (segundos); estourou -> fallback
LLM_TIMEOUT_SECONDS=4.5
LLM_TOTAL_BUDGET_SECONDS=5

# --- Dados de exemplo (prestadores e avaliações de demonstração) ---
SEED_DEMO_DATA=true

# --- BFFs ---
# true: se um microsserviço de domínio estiver fora do ar, o BFF devolve payloads de exemplo (docs/02).
# Mude para false quando os microsserviços estiverem rodando.
ENABLE_UPSTREAM_MOCK=true

# --- JWT de teste (usado por scripts/generate_jwt.py; o Kong lê o segredo de gateway/kong.yml) ---
JWT_SECRET=resolvelar-jwt-secret-2026
